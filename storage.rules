rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Solo usuarios autenticados pueden leer
      allow read: if request.auth != null;

      // Escritura: solo el propio usuario puede subir a su carpeta
      // y admins/líderes pueden subir a carpetas públicas
      match /avatars/{userId}/{fileName} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /posts/{postId}/{fileName} {
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && 
          (resource.metadata.uploadedBy == request.auth.uid || get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['lider_bosque', 'comite_departamental', 'admin']);
      }

      match /events/{eventId}/{fileName} {
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && 
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['lider_bosque', 'comite_departamental', 'admin'];
      }

      match /cartillas/{cartillaId}/{fileName} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && 
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin'];
      }

      match /niveles/{fileName} {
        allow read: if true;
        allow write: if false;
      }

      match /logos/{fileName} {
        allow read: if true;
        allow write: if false;
      }

      match /backgrounds/{fileName} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
